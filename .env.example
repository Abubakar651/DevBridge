# Copy to .env in this folder. Never put real keys in a tracked file.
# Existing keys in the repository-root .env are also read; this file takes priority.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional separate Orpheus key. GROQ_API_KEY_2 is also accepted as a legacy alias.
GROQ_API_KEY2=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_REASONING_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
HOST=127.0.0.1
PORT=4317
